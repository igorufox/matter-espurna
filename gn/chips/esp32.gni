# Build arguments of the ESP32 library (Xtensa LX6, stock ESP-IDF 5.5): gn gen
# --args='import("//chips/esp32.gni")' (ref. //.gn). The same application, data model and platform layer as the
# BK7231N one (//external_platform/Port, the firmware implements its matter_port.h), compiled with the flags of the
# ESP-IDF project of the library, gn/esp32 (chips/esp32_flags.gni, tools/gen_esp32_flags.py).
import("//build_overrides/chip.gni")
import("//chips/esp32_flags.gni")

custom_toolchain = "//toolchain:esp32"
target_cpu = "esp32"

is_debug = false
optimize_debug = false
optimize_for_size = true
symbol_level = 1

target_defines = []

target_cflags = esp32_defines + esp32_include_flags
target_cflags_c = esp32_cflags_c
target_cflags_cc = esp32_cflags_cc

# lwIP, FreeRTOS and mbedTLS of ESP-IDF (headers through target_cflags, the archives are in ESPurna's link)
mbedtls_target = "//mbedtls_idf:mbedtls"

import("//chips/matter.gni")
