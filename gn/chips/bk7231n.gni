# Build arguments of the BK7231N library (ARM968E-S, ARMv5TE, Thumb; FreeRTOS 11, lwIP 2.2.0, mbedTLS 3.6): gn gen
# --args='import("//chips/bk7231n.gni")' (ref. //.gn)
import("//build_overrides/chip.gni")
import("//chips/bk7231n_sdk.gni")

custom_toolchain = "//toolchain:bk7231n"

# CPU: the BK7231N (-mcpu=arm968e-s -march=armv5te -mthumb -mthumb-interwork)
arm_arch = "armv5te"
arm_cpu = "arm968e-s"
arm_float_abi = "soft"
arm_use_thumb = true

is_debug = false
optimize_debug = false
optimize_for_size = true
symbol_level = 1

target_defines = []
target_cflags = [
                  "-mthumb-interwork",
                  "-fno-common",
                  "-fsigned-char",
                  "-ffunction-sections",
                  "-fdata-sections",
                ] + bk_sdk_defines + bk_sdk_include_flags
target_cflags_c = []
target_cflags_cc = [
  "-fno-rtti",
  "-fno-exceptions",
]

target_cpu = "arm"

# lwIP 2.2.0 and FreeRTOS 11 (headers through target_cflags, chips/bk7231n_sdk.gni), mbedTLS 3.6 headers (//mbedtls)
mbedtls_target = "//mbedtls:mbedtls"

import("//chips/matter.gni")
