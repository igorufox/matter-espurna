import("//build_overrides/chip.gni")
import("${chip_root}/src/platform/device.gni")


static_library("MatterApp") {
  sources = [
    "AppServer.cpp",
    "CHIPDeviceManager.cpp",
    "CommonDeviceCallbacks.cpp",
    "OTAHelper.cpp",
    "matter_app.cpp",
  ]
  public_deps = [
    "${chip_root}/examples/espurna-plug:plug-data-model",
    "${chip_root}/src/app/clusters/basic-information",
    "${chip_root}/src/app/persistence",
    "${chip_root}/src/app/persistence:singleton",
    "${chip_root}/src/lib",
    "${chip_root}/src/setup_payload",
  ]
  # the chip's port of the BK7231N (__atomic_*, the bk_* API ESPurna implements); the ESP32 platform is
  # connectedhomeip's own (src/platform/ESP32, through chip_device_platform)
  if (chip_device_platform == "external") {
    public_deps += [ "//external_platform/BK7231N:bk7231n_port" ]
  }
  # the log output of connectedhomeip (chip::Logging::Platform::LogV): the BK7231N port has it among its sources, the
  # ESP32 platform in a target of its own (ESP_LOG)
  if (chip_device_platform == "esp32") {
    public_deps += [ "${chip_root}/src/platform/ESP32:logging" ]
  }
  # mDNS: ESPurna's one responder publishes Matter's services on both chips (chip_mdns = "platform"; the ESP32
  # platform's DNS-SD on ESP-IDF's mdns is taken out by tools/chip_patch.py)
  # BLE: one BLEManagerImpl for every chip on the firmware's stack (app/matter_ble.h)
  if (chip_enable_ble) {
    sources += [ "../platform/ble/BLEManagerImpl.cpp" ]
  }
  if (chip_mdns == "platform") {
    sources += [ "../platform/EspurnaDnssd.cpp" ]
    public_deps += [ "${chip_root}/src/lib/dnssd:platform_header" ]
  }
  output_name = "libMatterApp"
  output_dir = "${root_out_dir}/lib"
  complete_static_lib = true
}

# The layout of what the library shares with the firmware (FreeRTOS, lwIP, mbedTLS types), compiled with the library's
# flags: not in libMatterApp.a, tools/abi.py makes matter_abi.h of the release package from this object
source_set("abi_probe") {
  sources = [ "matter_abi_probe.c" ]
  # the SDK headers come with the chip's flags, mbedTLS's with connectedhomeip's crypto (its mbedtls_target)
  deps = [
    ":MatterApp",
    "${chip_root}/src/crypto",
  ]
}
