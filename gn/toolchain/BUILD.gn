import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("${build_root}/toolchain/gcc_toolchain.gni")

declare_args() {
  # "wingcc": the Windows arm-none-eabi GCC 14.2.1 of PlatformIO, called from WSL through tools/wingcc.sh
  #           (tools/build.sh)
  # "native": the Linux build of the same PlatformIO package in //third_party/pio (tools/ci_build.sh)
  bk_toolchain = "wingcc"

  # the same for the ESP32: "wingcc" the Windows xtensa-esp32-elf GCC 14.2.0 of PlatformIO (tools/wingcc.sh esp32),
  # "native" the Linux one ESP-IDF installs in //third_party/esp32-toolchain (tools/ci_build.sh)
  esp32_toolchain = "wingcc"
}

if (bk_toolchain == "native") {
  _gcc = rebase_path(
          "//third_party/pio/packages/toolchain-gccarmnoneeabi/bin/arm-none-eabi-")
  _ar = "${_gcc}ar"
  _cc = "${_gcc}gcc"
  _cxx = "${_gcc}g++"
} else {
  _wrap = rebase_path("//../tools/wingcc.sh")
  _ar = "${_wrap} ar"
  _cc = "${_wrap} gcc"
  _cxx = "${_wrap} g++"
}

# ESP32: the xtensa-esp-elf GCC 14.2 ESP-IDF installs (its tools of tools/ci_build.sh), its xtensa-esp32-elf-*
# commands; //third_party/esp32-toolchain is a link made by tools/ci_build.sh
if (esp32_toolchain == "native") {
  _esp32 = rebase_path("//third_party/esp32-toolchain/bin/xtensa-esp32-elf-")
  _esp32_ar = "${_esp32}ar"
  _esp32_cc = "${_esp32}gcc"
  _esp32_cxx = "${_esp32}g++"
} else {
  _esp32_wrap = rebase_path("//../tools/wingcc.sh") + " esp32"
  _esp32_ar = "${_esp32_wrap} ar"
  _esp32_cc = "${_esp32_wrap} gcc"
  _esp32_cxx = "${_esp32_wrap} g++"
}

gcc_toolchain("esp32") {
  ar = _esp32_ar
  cc = _esp32_cc
  cxx = _esp32_cxx

  toolchain_args = {
    current_os = "freertos"
    current_cpu = "esp32"
    is_clang = false
  }
}

gcc_toolchain("bk7231n") {
  ar = _ar
  cc = _cc
  cxx = _cxx

  toolchain_args = {
    current_os = "freertos"
    current_cpu = "arm"
    is_clang = false
  }
}
